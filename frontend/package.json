{
  "name": "ely-site",
  "private": true,
  "type": "module",
  "scripts": {
    "gallery": "../scripts/web.sh public/gallery",
    "showcase": "node scripts/showcase.mjs",
    "dev": "pnpm showcase && vite",
    "build": "pnpm showcase && tsc --noEmit && vite build",
    "preview": "vite preview",
    "local": "ELY_GALLERY_ASSETS=http://localhost:4173/gallery/assets/ pnpm gallery && pnpm build && vite preview --port 4173 --strictPort",
    "deploy": "wrangler deploy",
    "e2e": "playwright test",
    "test": "node --test src/iso/engine.test.ts src/apps.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "marked": "18.0.14",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.143.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-router": "1.170.40",
    "lenis": "1.3.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reicon": "1.2.4"
  }
}
